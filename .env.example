# Database Configuration (Use a cloud hosted Postgres such as Neon.tech, Supabase, or Vercel Postgres)
DATABASE_URL=""
# If using Neon / Supabase with Prisma, you can also set DIRECT_URL if using migrations:
# DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/gtstyle?sslmode=require"

# NextAuth / Auth.js configuration
AUTH_SECRET=""
# On Vercel, set AUTH_TRUST_HOST=true for automatic domain resolution:
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Application Environment
NODE_ENV="production"

# Atelier Seller & Direct Order Concierge Settings
NEXT_PUBLIC_SELLER_BRAND="GTStyle Fine Jewelry"
NEXT_PUBLIC_SELLER_PHONE="+2349131850995"
NEXT_PUBLIC_SELLER_WHATSAPP="2348185463181"
NEXT_PUBLIC_SELLER_EMAIL="orders@gtstyle.com"

# Official Corporate Bank Settlement Details
